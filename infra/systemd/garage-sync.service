# Daily: catalog from GitHub (pull --rebase, keeping local trust commits), snapshots of new or bumped pins, the search index.
# Only what changed is fetched (a unit with a complete .garage.json is skipped); mirrored files are never run.
[Unit]
Description=garage: daily sync (git pull, mirror changed pins, rebuild the index)
After=network-online.target
Wants=network-online.target
OnFailure=lechu-alert@%N.service

[Service]
Type=oneshot
User=garage
Group=garage
UMask=0022
Environment=GARAGE_HOME=/data/apps/garage HOME=/var/lib/garage GIT_TERMINAL_PROMPT=0
WorkingDirectory=/data/apps/garage
# The pull rebases local commits (garage review/promote's trust/registry.yaml commits, garage.trustgit) on top of
# GitHub and autostashes anything uncommitted: nothing local is reset or overwritten. On a conflict the rebase is
# aborted (local state as before), the unit fails (alert) and someone resolves it by hand.
ExecStart=/bin/sh -c 'r=/data/apps/garage/repo; if [ -d "$r/.git" ] && git -C "$r" remote get-url origin >/dev/null 2>&1; then git -c user.name=garage -c user.email=garage@localhost -C "$r" pull -q --rebase --autostash || { git -C "$r" rebase --abort 2>/dev/null; echo "git pull --rebase failed in $r: rebase aborted, local trust commits kept; resolve by hand" >&2; exit 1; }; else echo "no git checkout with an origin in $r: pull skipped"; fi'
ExecStart=/usr/local/bin/garage mirror
ExecStart=/usr/local/bin/garage index
Nice=10
IOSchedulingClass=idle
MemoryMax=1G
TasksMax=64
TimeoutStartSec=8h
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/data/apps/garage /var/lib/garage
